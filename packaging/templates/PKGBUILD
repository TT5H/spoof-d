# Maintainer: TT5H
# AUR PKGBUILD for {{name}} {{version}}.
# Generated by packaging/generate.js -- do not hand-edit pkgver or sha256sums.
pkgname=nodejs-{{name}}
pkgver={{version}}
pkgrel=1
pkgdesc="{{description}}"
arch=('any')
url="{{homepage}}"
license=('{{license}}')
depends=('nodejs')
makedepends=('npm')
source=("{{name}}-$pkgver.tgz::{{url}}")
noextract=("{{name}}-$pkgver.tgz")
sha256sums=('{{sha256}}')

package() {
  npm install -g --prefix "$pkgdir/usr" "$srcdir/{{name}}-$pkgver.tgz"

  # npm records the build path in these; strip them so the package is reproducible.
  find "$pkgdir" -type d -exec chmod 755 {} +
  rm -f "$pkgdir/usr/lib/node_modules/.package-lock.json"
}
